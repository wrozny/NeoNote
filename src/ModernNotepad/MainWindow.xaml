<Window x:Class="ModernNotepad.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:edit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Width="1200" Height="780" MinWidth="700" MinHeight="400" WindowStartupLocation="CenterScreen" AllowDrop="True" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Icon><BitmapImage xmlns="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore" UriSource="Assets/NeoNote.ico"/></Window.Icon>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"><Menu x:Name="MainMenu" Padding="8,4"/></Border>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="14,7"><DockPanel><Button x:Name="OpenPreviewButton" DockPanel.Dock="Right" Padding="10,2" Margin="12,0,0,0" Visibility="Collapsed"/><TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    <Border x:Name="SearchPanel" DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="10,6" Visibility="Collapsed" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
      <WrapPanel>
        <TextBox x:Name="SearchBox" Width="190" Margin="2"/>
        <TextBox x:Name="ReplaceBox" Width="190" Margin="2"/>
        <Button x:Name="FindButton" Margin="2" Padding="12,3"/>
        <Button x:Name="ReplaceButton" Margin="2" Padding="12,3"/>
        <Button x:Name="ReplaceAllButton" Margin="2" Padding="12,3"/>
        <Button x:Name="CloseSearchButton" Content="×" Margin="2" Padding="10,3"/>
      </WrapPanel>
    </Border>
    <Grid x:Name="Workspace">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="*" MinWidth="260"/><ColumnDefinition x:Name="DividerColumn" Width="5"/><ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"><TextBlock x:Name="EditorHeading" Foreground="{DynamicResource Muted}" FontSize="12"/></Border>
        <edit:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="15" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16,12"/>
      </DockPanel>
      <GridSplitter x:Name="Divider" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Stroke}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
      <Grid Grid.Column="2" x:Name="PreviewHost" Background="{DynamicResource Surface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border Padding="16,6" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1"><DockPanel><Button x:Name="ClosePreviewButton" DockPanel.Dock="Right" Content="×" Padding="8,0" FontSize="18" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="PreviewHeading" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
        <web:WebView2CompositionControl x:Name="Preview" Grid.Row="1" Visibility="Visible"/>
        <Border x:Name="PreviewNotice" Grid.Row="1" Panel.ZIndex="1" Background="{DynamicResource Surface}" Padding="24">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
            <TextBlock x:Name="PreviewMessage" TextWrapping="Wrap" Margin="0,0,0,14" Foreground="{DynamicResource Text}"/>
            <Button x:Name="RetryPreviewButton" HorizontalAlignment="Left" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
